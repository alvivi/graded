// wisp — web framework

assume wisp.configure_logger : [Stdout]
assume wisp.delete_temporary_files : [FileSystem]
assume wisp.log_alert : [Stdout]
assume wisp.log_critical : [Stdout]
assume wisp.log_debug : [Stdout]
assume wisp.log_emergency : [Stdout]
assume wisp.log_error : [Stdout]
assume wisp.log_info : [Stdout]
assume wisp.log_notice : [Stdout]
assume wisp.log_request : [Stdout]
assume wisp.log_warning : [Stdout]
assume wisp.new_temporary_file : [FileSystem]
assume wisp.random_string : [Random]
assume wisp.serve_static : [FileSystem]
assume wisp.set_logger_level : [Stdout]
assume wisp/wisp_mist.handler : [Network, Process]
