// mist — web server

assume mist.read_body : [Network]
assume mist.read_request_body : [Network]
assume mist.send_binary_frame : [Network]
assume mist.send_chunk : [Network]
assume mist.send_event : [Network]
assume mist.send_file : [FileSystem]
assume mist.send_text_frame : [Network]
assume mist.start : [Network, Process]
assume mist.stream : [Network]
assume mist.supervised : [Network, Process]
