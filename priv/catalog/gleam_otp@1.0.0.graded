// gleam_otp — OTP actors and supervisors

assume gleam/otp/supervision : []

assume gleam/otp/actor.call : [Process]
assume gleam/otp/actor.continue : []
assume gleam/otp/actor.initialised : []
assume gleam/otp/actor.named : []
assume gleam/otp/actor.new : []
assume gleam/otp/actor.new_with_initialiser(initialise: [initialise]) : [initialise] where runs : []
assume gleam/otp/actor.on_message(handler: [handler]) : [handler] where runs : []
assume gleam/otp/actor.returning : []
assume gleam/otp/actor.selecting : []
assume gleam/otp/actor.send(msg: [msg]) : [Process] where runs : [msg]
assume gleam/otp/actor.start(builder: [builder]) : [Process] where runs : [builder]
assume gleam/otp/actor.stop : []
assume gleam/otp/actor.stop_abnormal : []
assume gleam/otp/actor.with_selector : []

assume gleam/otp/static_supervisor.add : []
assume gleam/otp/static_supervisor.auto_shutdown : []
assume gleam/otp/static_supervisor.new : []
assume gleam/otp/static_supervisor.restart_tolerance : []
assume gleam/otp/static_supervisor.start(builder: [builder]) : [Process] where runs : [builder]
assume gleam/otp/static_supervisor.supervised : []

assume gleam/otp/factory_supervisor.count_children : [Process]
assume gleam/otp/factory_supervisor.get_by_name : [Process]
assume gleam/otp/factory_supervisor.named : []
assume gleam/otp/factory_supervisor.restart_strategy : []
assume gleam/otp/factory_supervisor.restart_tolerance : []
assume gleam/otp/factory_supervisor.start(builder: [builder]) : [Process] where runs : [builder]
assume gleam/otp/factory_supervisor.start_child(argument: [argument]) : [Process] where runs : [argument]
assume gleam/otp/factory_supervisor.supervised : []
assume gleam/otp/factory_supervisor.supervisor_child(template: [template]) : [template] where runs : []
assume gleam/otp/factory_supervisor.timeout : []
assume gleam/otp/factory_supervisor.worker_child(template: [template]) : [template] where runs : []

assume gleam/otp/system.debug_state : [Process]
assume gleam/otp/system.get_state : [Process]
assume gleam/otp/system.resume : [Process]
assume gleam/otp/system.suspend : [Process]

// gleam_otp — what the reviewed functions do with the functions they are given
assume gleam/otp/supervision.map_data(transform: [transform]) : [transform] where runs : []
assume gleam/otp/supervision.supervisor(start: [start]) : [start] where runs : []
assume gleam/otp/supervision.worker(start: [start]) : [start] where runs : []
