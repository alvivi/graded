// lustre — pure submodules for element/effect construction
assume lustre/element : []
assume lustre/element/html : []
assume lustre/element/svg : []
assume lustre/element/keyed : []
assume lustre/element/mathml : []
assume lustre/attribute : []
assume lustre/event : []
assume lustre/effect : []
assume lustre/component : []
assume lustre/dev/query : []

// lustre — App/value constructors (pure data)
assume lustre.application : []
assume lustre.simple : []
assume lustre.component : []
assume lustre.element : []
assume lustre.named : []
assume lustre.dispatch : []
assume lustre.shutdown : []
assume lustre.supervised : []
assume lustre.is_browser : []

// lustre — effectful runtime functions
assume lustre.start : [Process, Dom]
assume lustre.start_server_component : [Process]
assume lustre.send : [Process]
assume lustre.register : [Dom]
assume lustre.is_registered : [Dom]
assume lustre.factory : [Process]

// lustre/server_component — effectful runtime management
assume lustre/server_component.subject : [Process]
assume lustre/server_component.pid : [Process]
assume lustre/server_component.register_subject : [Process]
assume lustre/server_component.deregister_subject : [Process]
assume lustre/server_component.register_callback : [Process]
assume lustre/server_component.deregister_callback : [Process]
assume lustre/server_component.emit : [Dom]
