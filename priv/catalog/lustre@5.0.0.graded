// lustre — pure submodules for element/effect construction
assume lustre/element : []
assume lustre/element/html : []
assume lustre/element/svg : []
assume lustre/element/keyed : []
assume lustre/element/mathml : []
assume lustre/attribute : []
assume lustre/event : []
assume lustre/effect : []
assume lustre/component : []
assume lustre/dev/query : []

// lustre — App/value constructors (pure data)
assume lustre.application(init: [init], update: [update], view: [view]) : [init, update, view] where runs : []
assume lustre.simple(init: [init], update: [update], view: [view]) : [init, update, view] where runs : []
assume lustre.component(init: [init], update: [update], view: [view]) : [init, update, view] where runs : []
assume lustre.element : []
assume lustre.named : []
assume lustre.dispatch : []
assume lustre.shutdown : []
assume lustre.supervised : []
assume lustre.is_browser : []

// lustre — effectful runtime functions
assume lustre.start(app: [a]) : [Process, Dom] where runs : [a]
assume lustre.start_server_component(app: [a]) : [Process] where runs : [a]
assume lustre.send(message: [message]) : [Process] where runs : [message]
assume lustre.register : [Dom]
assume lustre.is_registered : [Dom]
assume lustre.factory : [Process]

// lustre/server_component — pure builders and codecs
assume lustre/server_component.client_message_to_json(message: [message]) : [] where runs : [message]
assume lustre/server_component.csrf_token : []
assume lustre/server_component.element : []
assume lustre/server_component.include : []
assume lustre/server_component.method : []
assume lustre/server_component.route : []
assume lustre/server_component.runtime_message_decoder : []
assume lustre/server_component.script : []
assume lustre/server_component.select(sel: [sel]) : [sel] where runs : []

// lustre/server_component — effectful runtime management
assume lustre/server_component.subject : [Process]
assume lustre/server_component.pid : [Process]
assume lustre/server_component.register_subject : [Process]
assume lustre/server_component.deregister_subject : [Process]
assume lustre/server_component.register_callback(callback: [callback]) : [Process, callback] where runs : []
assume lustre/server_component.deregister_callback(callback: [callback]) : [Process, callback] where runs : []
assume lustre/server_component.emit : [Dom]

// lustre — what the reviewed functions do with the functions they are given
assume lustre/component.on_attribute_change(decoder: [decoder]) : [decoder] where runs : []
assume lustre/component.on_form_autofill(handler: [handler]) : [handler] where runs : []
assume lustre/component.on_form_disabled(handler: [handler]) : [handler] where runs : []
assume lustre/component.on_form_restore(handler: [handler]) : [handler] where runs : []
assume lustre/component.prerender(component: [component]) : [] where runs : [component]
assume lustre/dev/query.find(root: [root]) : [] where runs : [root]
assume lustre/dev/query.find_all(root: [root]) : [] where runs : [root]
assume lustre/dev/query.find_path(root: [root]) : [] where runs : [root]
assume lustre/dev/query.has(element: [element]) : [] where runs : [element]
assume lustre/dev/query.matches(element: [element]) : [] where runs : [element]
assume lustre/effect.after_paint(effect: [effect]) : [effect([])] where carries : [effect([])]
assume lustre/effect.before_paint(effect: [effect]) : [effect([])] where carries : [effect([])]
assume lustre/effect.from(effect: [effect]) : [effect([])] where carries : [effect([])]
assume lustre/effect.map(effect: [effect], f: [f]) : [f] where runs : [], relay : f(effect)
assume lustre/effect.perform(effect: [effect]) : [] where runs : [effect]
assume lustre/element.map(element: [element], f: [f]) : [f] where runs : [], relay : f(element)
assume lustre/element.memo(view: [view]) : [view] where runs : []
assume lustre/element.to_document_string(el: [el]) : [] where runs : [el]
assume lustre/element.to_document_string_tree(el: [el]) : [] where runs : [el]
assume lustre/element.to_readable_string(el: [el]) : [] where runs : [el]
assume lustre/element.to_string(element: [element]) : [] where runs : [element]
assume lustre/element.to_string_tree(element: [element]) : [] where runs : [element]
