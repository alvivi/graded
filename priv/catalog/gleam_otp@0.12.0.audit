// gleam_otp, reviewed against the source of 0.12.0.
// Starting an actor or a supervisor runs what its builder or specification
// holds, in a process graded does not see; the builders only hold what they
// are given. A message sent to an actor escapes to it.

covers 0.12.0
container gleam/otp/port.Port
container gleam/otp/system.DebugState
container gleam/otp/supervisor.ApplicationStop
reviewed gleam/otp/actor.call
contract gleam/otp/actor.send(msg: [msg]) : [Process] where runs : [msg]
contract gleam/otp/actor.start(state: [state], loop: [loop]) : [Process, loop] where runs : [state]
contract gleam/otp/actor.start_spec(spec: [spec]) : [Process] where runs : [spec]
reviewed gleam/otp/supervisor.start
contract gleam/otp/supervisor.start_spec(spec: [spec]) : [Process] where runs : [spec]
