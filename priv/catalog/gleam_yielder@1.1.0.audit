// gleam_yielder 1.1.0. A yielder holds the thunks that produce its elements:
// the consumers run it, and the builders only hold it and their callbacks.

covers 1.1.0
container_result gleam/yielder.all
contract gleam/yielder.all(yielder: [yielder], predicate: [predicate]) : [predicate] where runs : [yielder], relay : predicate(yielder)
