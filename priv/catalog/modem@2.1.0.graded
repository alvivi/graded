// modem — URL and navigation handling for Lustre apps

// modem — reads the browser's location
assume modem.initial_uri : [Dom]

// modem — Effect constructors (pure data; Lustre's runtime performs them)
assume modem.advanced : [] where runs : [], carries : [Dom]
assume modem.back : [] where runs : [], carries : [Dom]
assume modem.forward : [] where runs : [], carries : [Dom]
assume modem.init : [] where runs : [], carries : [Dom]
assume modem.load : [] where runs : [], carries : [Dom]
assume modem.push : [] where runs : [], carries : [Dom]
assume modem.replace : [] where runs : [], carries : [Dom]

// modem — headless simulation for tests
assume modem.simulate : []
