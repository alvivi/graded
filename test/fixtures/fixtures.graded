check shadow_receiver.shadowed : [Stdout]
check shadow_receiver.logger_param : [Stdout]
check shadow_receiver.typed_param : [Stdout]
// An effectful field against the pure module its receiver is named after. The
// [] budget is the soundness assertion itself: every one of these but `count`
// must fail it, and fail with the field's [Net] or [Unknown] — the budget
// passing would mean the pure `gleam/list` answered for a network call.
check field_module_collision.count : []
check field_module_collision.direct_construction : []
check field_module_collision.case_narrowed : []
check field_module_collision.let_assert_narrowed : []
check field_module_collision.simple_alias : []
check field_module_collision.block_alias : []
check field_module_collision.alias_in_narrowed_branch : []
check field_module_collision.rebound_after_narrowing : []
// The same collision with the module half available: `gleam/io` really exports
// `println`, so both readings are in reach at once and only the receiver's
// narrowed type settles it. The [] budget must fail with the field's [Net] or
// with [Unknown], and never with the module's own answer.
check narrowed_module_collision.greet : [Stdout]
check narrowed_module_collision.case_narrowed : []
check narrowed_module_collision.let_assert_narrowed : []
check narrowed_module_collision.direct_construction : []
check shadow_param.run_alias(handler: []) : []
check external_same_module.read_clock : []
check recursive_fn_arg.walk : []
check recursive_fn_arg.run : []
check recursive_returned_operator.run : []
check recursive_returned_operator.run_cb : []
check factory_forward.caller(resolver: [Stdout]) : []
check factory_forward.caller_ctor(resolver: [Stdout]) : []
check factory_forward.caller_labeled(resolver: [Stdout]) : []
check factory_forward.caller_shorthand(resolver: [Stdout]) : []
check factory_forward.caller_alias(resolver: [Stdout]) : []
check factory_forward.caller_ctor_alias(resolver: [Stdout]) : []
check factory_forward.caller_nested(resolver: [Stdout]) : []
check factory_forward.caller_computed(resolver: [Stdout]) : []
check factory_forward.caller_computed_alias : []
check factory_forward.caller_shadow : []
check factory_forward.mixed_caller(run: [Stdout]) : []
check provenance_passthrough.caller(resolver: [Stdout]) : []
check provenance_getter.caller(resolver: [Stdout]) : []
check provenance_rebuild.caller(resolver: [Stdout]) : []
check provenance_partial.caller(resolver: [Stdout]) : []
check provenance_shorthand.caller(resolver: [Stdout]) : []
check provenance_labeled.caller(resolver: [Stdout]) : []
check provenance_recursion.caller(resolver: [Stdout]) : []
check provenance_binding.caller(resolver: [Stdout]) : []
check provenance_branch.caller(resolver: [Stdout]) : []
check provenance_branch_path.caller(resolver: [Stdout]) : []
check provenance_branch_build.caller(resolver: [Stdout]) : []
check provenance_computed_deep.caller : []
check provenance_external.caller : []
check why_target.two_bounds(f: [Stdout]) : [Stdout]
check why_target.two_bounds(g: [Stdout]) : [Stdout]
check why_target.checked_calls_helper_twice : []
check why_target.bound_forwards(action: [action]) : [action]
// Budgets on the externals themselves, checked against what declares them.
check external_budget.declared_over_budget : []
check external_budget.declared_within_budget : [Time]
check external_budget.undeclared : []
check external_budget.stale_inferred : []
// A budget on a caller of an external, checked against the same declaration.
check external_budget.wrapper : []
// The same declaration answers where the external is passed as a value rather
// than called: as a callback, and wired into a record field.
check external_budget.passes_external_as_callback : []
check external_budget.calls_wired_external : []
// The value channels of foreign code: the operator it returns, the provenance of
// what it builds, and the fields its factory and update-builder shapes wire. The
// budget each pair shares is what the ordinary twin costs, so the foreign half
// exceeds it only by resolving to [Unknown].
check foreign_values.calls_returned_operator : [Disk]
check foreign_values.calls_partial_operator : [Disk]
check foreign_values.calls_native_operator : [Disk]
// The one value channel a declaration reaches: the operator the producer hands
// back is declared, so the call of it costs what the line says.
check foreign_values.calls_declared_operator : [Disk]
check foreign_values.calls_built_field : [Disk]
check foreign_values.calls_native_built_field : [Disk]
check foreign_values.calls_updated_field : [Disk]
check foreign_values.calls_native_updated_field : [Disk]
check foreign_values.calls_via_provenance : [Disk]
check foreign_values.calls_native_via_provenance : [Disk]

// External effects (third-party / FFI functions graded can't see into).
assume external_same_module.now : [Time]
assume external_budget.declared_over_budget : [Time]
assume external_budget.declared_within_budget : [Time]
assume external_budget.declared_unknown : [Unknown]
assume builder_field.read_disk : [Disk]
assume builder_chain.disk_read : [Disk]
assume builder_shadow.disk_read : [Disk]
assume local_wired.read_disk : [Disk]
assume local_wired.opaque_read : []
assume shadow_field.split : []
assume field_module_collision.net_send : [Net]
assume narrowed_module_collision.net_send : [Net]
assume foreign_values.disk_read : [Disk]
assume foreign_values.portable_disk_read : [Disk]
// Declared, and still refused on every value channel: what a declaration says
// about calling a function says nothing about the value it returns.
assume foreign_values.declared_returns_operator : []
assume foreign_values.returns_operator : []
assume foreign_values.partial_returns_operator : []
assume foreign_values.builds : []
assume foreign_values.with_run : []
// What the producer above hands back, which no `assume` line states.
assume foreign_values.declared_returns_operator where returns : [Disk]

// A module-level external over a module that is not a project module and not a
// dependency: every name under `fake_clock` resolves to [Time], including ones
// nothing defines, which is what `graded effect`'s carve-out answers from. The
// spec lint flags the same line as a probable typo — deliberately: the two say
// different things, and nothing here should silence either.
assume fake_clock : [Time]

// Type field annotations (the effect source for type-directed field calls).
assume opaque_receiver.Validator.to_error : [Stdout]
assume nested_field.Inner.run : [Disk]
assume pipe_field.Inner.run : [Disk]
assume field_module_collision.Client.send : [Net]
assume narrowed_module_collision.Client.println : [Net]

// Inferred effects (regenerated by `graded infer`).
// Stale on purpose: `external_budget.stale_inferred` is an `@external`, so this
// line is what a formerly-pure function leaves behind. It must not answer for
// the foreign code. `graded infer` rewrites it to `[Unknown]`.
effects external_budget.stale_inferred : []
effects impure_view.view : [Stdout]
effects pure_view.view : []
effects transitive.view : [Stdout]
effects validator_flow.run : [Stdout]
effects opaque_receiver.run : [Stdout]
effects inferred_field.run : [Stdout]
effects local_field.my_logger : [Stdout]
effects local_field.run : [Stdout]
effects builder_field.run_replaced : [Stdout]
effects builder_field.run_default : [Disk]
effects builder_field.run_inline_arg : [Stdout]
effects builder_field.run_labeled_reordered : [Stdout]
effects builder_field.run_union : [Disk, Stdout]
effects builder_shadow.silent : []
effects builder_shadow.handler : []
effects shadow_field.handler : []
effects shadow_receiver.shadowed : [Stdout]
effects shadow_receiver.make_logger : []
effects shadow_receiver.logger_param : [Stdout]
effects shadow_receiver.logger_call_result : []
effects shadow_receiver.logger_narrowed : [Unknown]
effects shadow_receiver.make_typed : []
effects shadow_receiver.typed_param : [Stdout]
effects shadow_receiver.typed_narrowed : [Unknown]
effects field_module_collision.count : []
effects field_module_collision.direct_construction : [Net]
effects field_module_collision.case_narrowed : [Unknown]
effects field_module_collision.let_assert_narrowed : [Net]
effects field_module_collision.simple_alias : [Net]
effects field_module_collision.block_alias : [Net]
effects field_module_collision.alias_in_narrowed_branch : [Unknown]
effects field_module_collision.rebound_after_narrowing : [Net]
effects narrowed_module_collision.greet : [Stdout]
effects narrowed_module_collision.case_narrowed : [Unknown]
effects narrowed_module_collision.let_assert_narrowed : [Net]
effects narrowed_module_collision.direct_construction : [Net]
effects shadow_field.go : [Unknown]
effects factory_field.run : [Stdout]
// Committed bounds whose variable is deliberately named apart from the source
// parameter (`f`): a query must render this pair, not a freshly inferred one.
effects nested_higher_order.pure_forward(g: [g]) : [g]
// Committed with no bounds though the source is higher-order: this line decides
// the term, so it decides the (absent) bounds too — inference must not fill them.
effects nested_higher_order.log_and_map : [Stdout]
// Stale beside the authoritative `assume external_same_module.now`
// line above: neither the term nor the bounds may reach the knowledge base.
effects external_same_module.now(cb: [cb]) : [cb]
// Names nothing: `impure_view` is a project module that parses and defines no
// such function, so `graded effect` declines the name rather than quote this.
effects impure_view.no_such_function : []
// A *private* function of a project module. Same rule, other absence: the
// package does not export it, so the query declines it too.
effects builder_shadow.disk_resolver : [Disk]
