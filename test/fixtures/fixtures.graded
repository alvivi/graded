// Budgets on the externals themselves, checked against what declares them.
check external_budget.declared_over_budget : []
check external_budget.declared_within_budget : [Time]
check external_budget.undeclared : []
check external_budget.stale_inferred : []
// A budget on a caller of an external, checked against the same declaration.
check external_budget.wrapper : []
// The same declaration answers where the external is passed as a value rather
// than called: as a callback, and wired into a record field.
check external_budget.passes_external_as_callback : []
check external_budget.calls_wired_external : []
// The value channels of foreign code: the operator it returns, the provenance of
// what it builds, and the fields its factory and update-builder shapes wire. The
// budget each pair shares is what the ordinary twin costs, so the foreign half
// exceeds it only by resolving to [Unknown].
check foreign_values.calls_returned_operator : [Disk]
check foreign_values.calls_partial_operator : [Disk]
check foreign_values.calls_native_operator : [Disk]
check foreign_values.calls_built_field : [Disk]
check foreign_values.calls_native_built_field : [Disk]
check foreign_values.calls_updated_field : [Disk]
check foreign_values.calls_native_updated_field : [Disk]
check foreign_values.calls_via_provenance : [Disk]
check foreign_values.calls_native_via_provenance : [Disk]

// External effects (third-party / FFI functions graded can't see into).
external effects external_same_module.now : [Time]
external effects external_budget.declared_over_budget : [Time]
external effects external_budget.declared_within_budget : [Time]
external effects external_budget.declared_unknown : [Unknown]
external effects builder_field.read_disk : [Disk]
external effects builder_chain.disk_read : [Disk]
external effects builder_shadow.disk_read : [Disk]
external effects local_wired.read_disk : [Disk]
external effects local_wired.opaque_read : []
external effects shadow_field.split : []
external effects foreign_values.disk_read : [Disk]
// Declared, and still refused on every value channel: what a declaration says
// about calling a function says nothing about the value it returns.
external effects foreign_values.returns_operator : []
external effects foreign_values.partial_returns_operator : []
external effects foreign_values.builds : []
external effects foreign_values.with_run : []
// A module-level external: every function under `fake_clock` resolves to
// [Time], including names no fixture module defines.
external effects fake_clock : [Time]

// Type field annotations (the effect source for type-directed field calls).
type opaque_receiver.Validator.to_error : [Stdout]
type nested_field.Inner.run : [Disk]
type pipe_field.Inner.run : [Disk]

// Inferred effects (regenerated by `graded infer`).
// Stale on purpose: `external_budget.stale_inferred` is an `@external`, so this
// line is what a formerly-pure function leaves behind. It must not answer for
// the foreign code. `graded infer` rewrites it to `[Unknown]`.
effects external_budget.stale_inferred : []
effects impure_view.view : [Stdout]
effects pure_view.view : []
effects transitive.view : [Stdout]
effects validator_flow.run : [Stdout]
effects opaque_receiver.run : [Stdout]
effects inferred_field.run : [Stdout]
effects local_field.my_logger : [Stdout]
effects local_field.run : [Stdout]
effects builder_field.run_replaced : [Stdout]
effects builder_field.run_default : [Disk]
effects builder_field.run_inline_arg : [Stdout]
effects builder_field.run_labeled_reordered : [Stdout]
effects builder_field.run_union : [Disk, Stdout]
effects builder_shadow.silent : []
effects builder_shadow.handler : []
effects shadow_field.handler : []
effects shadow_field.go : [Unknown]
effects factory_field.run : [Stdout]
// Committed bounds whose variable is deliberately named apart from the source
// parameter (`f`): a query must render this pair, not a freshly inferred one.
effects nested_higher_order.pure_forward(g: [g]) : [g]
// Committed with no bounds though the source is higher-order: this line decides
// the term, so it decides the (absent) bounds too — inference must not fill them.
effects nested_higher_order.log_and_map : [Stdout]
// Stale beside the authoritative `external effects external_same_module.now`
// line above: neither the term nor the bounds may reach the knowledge base.
effects external_same_module.now(cb: [cb]) : [cb]
// Names nothing: `impure_view` is a project module that parses and defines no
// such function, so `graded effect` declines the name rather than quote this.
effects impure_view.no_such_function : []
// A *private* function of a project module. Same rule, other absence: the
// package does not export it, so the query declines it too.
effects builder_shadow.disk_resolver : [Disk]
